TELEGRAM_BOT_TOKEN=
TYPESAFE_API_KEY=
# Empty = every group where the bot has Ban users and Delete messages admin rights.
# Optional: comma-separated numeric group IDs to limit moderation to specific groups.
TELEGRAM_CHAT_IDS=
JEV_MODEL=jev-1.14.0
JEV_API_URL=https://api.typesafe.ai/v1/systemone
# Default for groups without an override. In DM use /select, then /dryrun on or off per group.
# Dry run skips bans, deletion, join mutes, and unbans; settings changes still take effect.
DRY_RUN=true
BAN_THRESHOLD=0.98
REVIEW_THRESHOLD=0.70
# Optional comma-separated Telegram user IDs exempt from moderation.
EXEMPT_USER_IDS=
# Customize for your community; these are trusted operator instructions.
MODERATION_POLICY="Disallow unsolicited advertising, referral promotions, scams, and disruptive spam. Allow relevant discussion, genuine recommendations, and quoted examples of spam."
DATABASE_PATH=data/banhammer.sqlite3
# Only recent events are actionable, including recently edited older messages.
MAX_EVENT_AGE_SECONDS=300
HISTORY_TTL_SECONDS=600
HISTORY_LIMIT=5
AVATAR_CACHE_SECONDS=300
MAX_IMAGE_BYTES=2097152
API_TIMEOUT_SECONDS=15
